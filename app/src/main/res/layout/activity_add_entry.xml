<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/very_light_pink"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Title for the screen where the user adds a new workout -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Workout"
        android:textColor="@color/hot_pink"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Enter today's workout details"
        android:textColor="@color/dark_gray"
        android:textSize="16sp" />

    <!-- Lets the user enter the name of their exercise -->
    <EditText
        android:id="@+id/exerciseEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:hint="Exercise Name"
        android:inputType="textCapWords"
        android:textColor="@color/dark_gray"
        android:textColorHint="@color/dark_pink" />

    <!-- Lets the user enter how long their workout lasted -->
    <EditText
        android:id="@+id/durationEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Duration in Minutes"
        android:inputType="number"
        android:textColor="@color/dark_gray"
        android:textColorHint="@color/dark_pink" />

    <!-- Lets the user enter how many calories they burned -->
    <EditText
        android:id="@+id/caloriesEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Calories Burned"
        android:inputType="number"
        android:textColor="@color/dark_gray"
        android:textColorHint="@color/dark_pink" />

    <!-- Saves the workout into my Room database -->
    <Button
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:backgroundTint="@color/hot_pink"
        android:text="Save Workout"
        android:textColor="@color/white"
        android:textStyle="bold" />

</LinearLayout>